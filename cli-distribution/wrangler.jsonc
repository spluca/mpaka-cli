{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mpaka-cli-distribution",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "cli.mpaka.dev",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CLI_RELEASES",
      "bucket_name": "mpaka-cli-releases"
    }
  ]
}
